<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 p-4 border-start border-4 border-info">
            <div class="d-flex align-items-center">
                <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3 text-info">
                    <i class="fas fa-boxes fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Total Products</h6>
                    <h3 class="fw-bold mb-0"><%= stats.totalProducts %></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4 border-start border-4 border-primary">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3 text-primary">
                    <i class="fas fa-list fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Categories</h6>
                    <h3 class="fw-bold mb-0"><%= stats.totalCategories %></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4 border-start border-4 border-warning">
            <div class="d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3 text-warning">
                    <i class="fas fa-stream fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Subcategories</h6>
                    <h3 class="fw-bold mb-0"><%= stats.totalSubcategories %></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Products by Category</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th class="text-end">Products</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stats.productByCat.forEach(cat => { %>
                                <tr>
                                    <td><%= cat.name %></td>
                                    <td class="text-end fw-bold text-info"><%= cat.count %></td>
                                </tr>
                            <% }) %>
                            <% if(stats.productByCat.length === 0) { %>
                                <tr><td colspan="2" class="text-center text-muted">No data</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Products by Subcategory</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Subcategory</th>
                                <th class="text-end">Products</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stats.productBySubCat.forEach(sub => { %>
                                <tr>
                                    <td><%= sub.name %></td>
                                    <td class="text-end fw-bold text-warning"><%= sub.count %></td>
                                </tr>
                            <% }) %>
                            <% if(stats.productBySubCat.length === 0) { %>
                                <tr><td colspan="2" class="text-center text-muted">No data</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
